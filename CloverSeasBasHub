local FLY_SPEED = 60

-- FARM LEVEL
local FARM_TWEEN_SPEED = 120   -- studs por segundo
local ATTACK_DISTANCE = 2.5      -- distância atrás do NPC
local ATTACK_RATE = 0.1        -- intervalo entre cada Tool:Activate()
local QUEST_REFIRE = 2.5       -- reenvia a quest a cada X s (se já estiver ativa, o servidor ignora)
local FARM_REPICK = 25         -- reavalia a quest/alvo a cada X s
-- Se o script não conseguir ler seu level sozinho, coloque aqui (ex: MANUAL_LEVEL = 30)
