end

function RefreshTexts()
    Subtitle.Text = Tr("subtitle")
    MainInfo.Text = Tr("MainText")

    for _, Info in ipairs(TabInfo) do
        local Button = TabButtons[Info.Name]
        if Button then
            Button.Text = "  " .. Tr(Info.Name)
        end
    end

    for _, Page in ipairs(Containers) do
        for _, Object in ipairs(Page:GetDescendants()) do
            if Object:IsA("TextLabel") then
                if Object.Name:sub(1, 8) == "Section_" then
                    Object.Text = Tr(Object.Name:sub(9))
                elseif Object.Name == "Label" then
                    Object.Text = Tr(Object.Parent.Name)
                end
            end
        end
    end

    LanguageButton.Text = "🌐  " .. Tr("Language")
        .. ": " .. LanguageNames[Language]

    for _, Object in ipairs(SettingsPage:GetChildren()) do
        if Object:IsA("TextButton")
            and Object.Name:sub(-6) == "Action" then
            if Object ~= LanguageButton then
                Object.Text = "  " .. Tr(Object.Name:sub(1, -7))
            end
        end
    end

    ChangeTab(CurrentTab)
end

