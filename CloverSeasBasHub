local function IsGrimoireTool(Tool)
    return Tool:IsA("Tool") and Tool.Name:lower():find("grim") ~= nil
end

local StoreAttempt = setmetatable({}, {__mode = "k"})

local function SetAutoStore(Value)
    State.AutoStore = Value

    if Value then
        RunLoop("AutoStore", function(Active)
            local Tools = {}

            local Backpack = Player:FindFirstChildOfClass("Backpack")
            if Backpack then
                for _, Tool in ipairs(Backpack:GetChildren()) do
                    table.insert(Tools, Tool)
                end
            end

            local Char = GetChar()
            if Char then
                for _, Tool in ipairs(Char:GetChildren()) do
                    table.insert(Tools, Tool)
                end
            end

            for _, Tool in ipairs(Tools) do
                if not Active() then
                    return
                end

                if IsGrimoireTool(Tool) and (StoreAttempt[Tool] or 0) < os.clock() then
                    -- se o servidor recusar, só tenta de novo depois de 5s
                    StoreAttempt[Tool] = os.clock() + 5

                    local Name = Tool.Name
                    local Ok, Result = CallRemote("GrimoireItemAction", 5, "Store", Tool)
                    local Success = Describe(Result)

                    if Ok and Success == true then
                        Notify("Grimoire stored: " .. Name)
                    end
                end
            end

            WaitActive(2, Active)
        end)
    end
end

-- só considera "cooldown restante" em campos que realmente indicam tempo restante
local function ParseRemaining(StateResult)
    if type(StateResult) ~= "table" then
        return nil
    end

    for Key, Value in pairs(StateResult) do
        if type(Key) == "string" and type(Value) == "number" then
            local K = Key:lower()

            if K:find("remaining") or K:find("left") or K:find("next") then
                if Value > 1e9 then
                    Value = Value - os.time()
                end

                if Value > 0 then
                    return Value
                end
            end
        end
    end

    return nil
end

local function SetAutoSpin(Value)
    State.AutoSpin = Value

    if Value then
        RunLoop("AutoSpin", function(Active)
            local Level = GetLevel()

            -- regra do servidor: nível 25+
            if Level and Level < 25 then
                WaitActive(10, Active)
                return
            end

            -- se o estado informar cooldown restante, espera
            local OkState, StateResult = CallRemote("GetGrimoireGachaState", 4)
            local Remaining = OkState and ParseRemaining(StateResult)

            if Remaining then
                WaitActive(math.min(Remaining + 1, 60), Active)
                return
            end

            -- o servidor valida nível, dinheiro (28.600 + (nível-25) x 150) e cooldown
            local Ok, Result = CallRemote("GrimoireGachaSpinRequest", 6)
            local Success, Msg = Describe(Result)

            if Ok and Success == true then
                Notify("Grimoire spin sent")
            elseif Success == false and Msg then
                Notify(Msg)
            end

            WaitActive(20, Active)
        end)
    end
end

