local PanelDragging = false
local PanelDragStart
local PanelStartPosition

Top.InputBegan:Connect(function(Input)
    if Input.UserInputType == Enum.UserInputType.MouseButton1
        or Input.UserInputType == Enum.UserInputType.Touch then

        PanelDragging = true
        PanelDragStart = Input.Position
        PanelStartPosition = Main.Position
    end
end)

Track(UIS.InputChanged:Connect(function(Input)
    if not PanelDragging then
        return
    end

    if Input.UserInputType == Enum.UserInputType.MouseMovement
        or Input.UserInputType == Enum.UserInputType.Touch then

        local Delta = Input.Position - PanelDragStart

        Main.Position = UDim2.new(
            PanelStartPosition.X.Scale,
            PanelStartPosition.X.Offset + Delta.X,
            PanelStartPosition.Y.Scale,
            PanelStartPosition.Y.Offset + Delta.Y
        )
    end
end))

Track(UIS.InputEnded:Connect(function(Input)
    if Input.UserInputType == Enum.UserInputType.MouseButton1
        or Input.UserInputType == Enum.UserInputType.Touch then
        PanelDragging = false
    end
end))

-- ARRASTAR O ÍCONE INDEPENDENTEMENTE DO PAINEL
local IconDragging = false
local IconMoved = false
local IconDragStart
local IconStartPosition
local IconInput

OpenButton.InputBegan:Connect(function(Input)
    if Input.UserInputType == Enum.UserInputType.MouseButton1
        or Input.UserInputType == Enum.UserInputType.Touch then

        IconDragging = true
        IconMoved = false
        IconInput = Input
        IconDragStart = Input.Position
        IconStartPosition = OpenButton.Position
    end
end)

Track(UIS.InputChanged:Connect(function(Input)
    if not IconDragging then
        return
    end

    local IsMovement =
        Input.UserInputType == Enum.UserInputType.MouseMovement
        or Input.UserInputType == Enum.UserInputType.Touch

    if not IsMovement then
        return
    end

    if IconInput
        and IconInput.UserInputType == Enum.UserInputType.Touch
        and Input ~= IconInput then
        return
    end

    local Delta = Input.Position - IconDragStart

    if math.abs(Delta.X) > 5 or math.abs(Delta.Y) > 5 then
        IconMoved = true
    end

    if IconMoved then
        OpenButton.Position = UDim2.new(
            IconStartPosition.X.Scale,
            IconStartPosition.X.Offset + Delta.X,
            IconStartPosition.Y.Scale,
            IconStartPosition.Y.Offset + Delta.Y
        )
    end
end))

Track(UIS.InputEnded:Connect(function(Input)
    if not IconDragging then
        return
    end

    if Input.UserInputType == Enum.UserInputType.MouseButton1
        or Input.UserInputType == Enum.UserInputType.Touch then

        local WasMoved = IconMoved

        IconDragging = false
        IconInput = nil

        if not WasMoved then
            Main.Visible = not Main.Visible
        end
    end
end))

