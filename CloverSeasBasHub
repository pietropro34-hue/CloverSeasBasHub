end

local function TeleportTo(Position)
    local HRP = GetHRP()
    if not HRP then
        return
    end

    -- os farms também mexem no personagem, então desliga antes
    if State.FarmLevel then
        SetFarmLevel(false)
        if ToggleButtons.FarmLevel then
            ToggleButtons.FarmLevel()
        end
    end

    if State.MoneyFarm then
        SetMoneyFarm(false)
        if ToggleButtons.MoneyFarm then
            ToggleButtons.MoneyFarm()
        end
    end

    TeleportToken += 1
    local Id = TeleportToken
    Teleporting = true

    task.spawn(function()
        pcall(function()
            TweenTo(HRP, Position, TeleportSpeed, function()
                return TeleportToken == Id
            end)
        end)

        if TeleportToken == Id then
            Teleporting = false
        end
    end)
end

-- Workspace.Ilhas.(ilha): usa SpawnLocation se existir; senão o centro/topo da ilha
local function IslandPosition(Object)
    for _, Descendant in ipairs(Object:GetDescendants()) do
        if Descendant:IsA("SpawnLocation") then
            return Descendant.Position + Vector3.new(0, 5, 0)
        end
    end

    if Object:IsA("Model") then
        local CF, Size = Object:GetBoundingBox()
        return CF.Position + Vector3.new(0, Size.Y / 2 + 10, 0)
    end

    if Object:IsA("BasePart") then
        return Object.Position + Vector3.new(0, Object.Size.Y / 2 + 10, 0)
    end

    local Min, Max

    for _, Part in ipairs(Object:GetDescendants()) do
        if Part:IsA("BasePart") then
            local P = Part.Position

            if not Min then
                Min, Max = P, P
            else
                Min = Vector3.new(math.min(Min.X, P.X), math.min(Min.Y, P.Y), math.min(Min.Z, P.Z))
                Max = Vector3.new(math.max(Max.X, P.X), math.max(Max.Y, P.Y), math.max(Max.Z, P.Z))
            end
        end
    end

    if not Min then
        return nil
    end

    local Center = (Min + Max) / 2
    return Vector3.new(Center.X, Max.Y + 10, Center.Z)
end

local RebuildIslands, RebuildPlayers

function RebuildIslands(List)
    ClearList(List)

    local Ilhas = workspace:FindFirstChild("Ilhas")
    local Count = 0

    if Ilhas then
        for _, Island in ipairs(Ilhas:GetChildren()) do
            if Island.Name ~= "Baus" then
                Count += 1

                CreateItemRow(List, Island.Name, "Tween to island", "Go", function()
                    local Position = IslandPosition(Island)

                    if Position then
                        TeleportTo(Position)
                    else
                        Notify("Island position not found")
                    end
                end, Count)
            end
        end
    end

    if Count == 0 then
        CreateItemRow(List, "No islands found", "Workspace.Ilhas", "Reload", function()
            RebuildIslands(List)
        end, 1)
    end
end

function RebuildPlayers(List)
    ClearList(List)

    local Count = 0

    for _, Plr in ipairs(Players:GetPlayers()) do
        if Plr ~= Player then
            Count += 1

            CreateItemRow(List, Plr.DisplayName, "@" .. Plr.Name, "Go", function()
                local Char = Plr.Character
                local Root = Char and Char:FindFirstChild("HumanoidRootPart")

                if Root then
                    TeleportTo(Root.Position + Vector3.new(0, 3, 0))
                else
                    Notify("Player not found")
                end
            end, Count)
        end
    end

    if Count == 0 then
        CreateItemRow(List, "No other players", "Server is empty", "Reload", function()
            RebuildPlayers(List)
        end, 1)
    end
end

