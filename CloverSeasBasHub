local ManaChar

local function SetAutoMana(Value)
    State.AutoMana = Value
    ManaChar = nil

    if Value then
        RunLoop("AutoMana", function(Active)
            local Char, Hum = GetChar(), GetHum()

            if not Char or not Hum or Hum.Health <= 0 then
                task.wait(1)
                return
            end

            local function Attr(Name)
                local V = Char:GetAttribute(Name)
                if V == nil then
                    V = Player:GetAttribute(Name)
                end
                return V
            end

            -- o servidor recusa se estiver ManaBusy
            if Attr("ManaBusy") == true then
                task.wait(0.5)
                return
            end

            local On = Attr("ManaArmActive")

            if On == true then
                ManaChar = Char
                task.wait(1)
                return
            end

            -- se o atributo não existe, liga só uma vez por personagem
            if On == nil and ManaChar == Char then
                task.wait(1)
                return
            end

            ManaChar = Char
            CallRemote("ToggleHaki", 3, true)
            task.wait(1.5)
        end)
    end
end

