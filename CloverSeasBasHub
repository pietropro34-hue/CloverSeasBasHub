-- HELPERS: REMOTES, AVISOS, LISTAS
--------------------------------------------------------------------
local RemoteCache = {}

-- procura RemoteEvent/RemoteFunction pelo nome em qualquer lugar do ReplicatedStorage
local function FindRemote(Name)
    local Cached = RemoteCache[Name]
    if Cached and Cached.Parent then
        return Cached
    end

    for _, Object in ipairs(ReplicatedStorage:GetDescendants()) do
        if Object.Name == Name and (Object:IsA("RemoteEvent") or Object:IsA("RemoteFunction")) then
            RemoteCache[Name] = Object
            return Object
        end
    end

    return nil
end

-- chama o remote sem travar. Retorna ok, resultado
local function CallRemote(Name, Timeout, ...)
    local Remote = FindRemote(Name)
    if not Remote then
        return false, "remote not found: " .. Name
    end

    local Args = table.pack(...)

    if Remote:IsA("RemoteEvent") then
        local Ok = pcall(function()
            Remote:FireServer(table.unpack(Args, 1, Args.n))
        end)
        return Ok, nil
    end

    local Done, Ok, Result = false, false, nil

    task.spawn(function()
        Ok, Result = pcall(function()
            return Remote:InvokeServer(table.unpack(Args, 1, Args.n))
        end)
        Done = true
    end)

    local Start = os.clock()
    while not Done and os.clock() - Start < (Timeout or 5) do
        task.wait(0.1)
    end

    if not Done then
        return false, "timeout"
    end

    return Ok, Result
end

-- tenta entender a resposta do servidor: sucesso (true/false/nil), mensagem (string/nil)
local function Describe(Result)
    if type(Result) == "table" then
        local Success = Result.Success
        if Success == nil then Success = Result.success end
        if Success == nil then Success = Result.ok end
        if Success == nil then Success = Result.Ok end

        local Msg = Result.Message or Result.message or Result.Error or Result.error or Result.Reason

        return Success, Msg and tostring(Msg) or nil
    elseif type(Result) == "boolean" then
        return Result, nil
    elseif type(Result) == "string" then
        return nil, Result
    end

    return nil, nil
end

local function WaitActive(Seconds, Active)
