local function FormatNumber(Number)
    local Reversed = tostring(Number):reverse()
    Reversed = Reversed:gsub("(%d%d%d)", "%1.")
    local Result = Reversed:reverse()

    if Result:sub(1, 1) == "." then
        Result = Result:sub(2)
    end

    return Result
end

local BuyBusy = false

local function Purchase(Kind, Item, Button)
    if BuyBusy then
        return
    end

    BuyBusy = true
    Button.Text = "..."

    local Ok, Result = CallRemote("InventoryRequest", 6, Kind, {Id = Item.Id})
    local Success, Msg = Describe(Result)

    if not Ok then
        Notify("Purchase failed: " .. tostring(Result))
    elseif Success == true then
        Notify("Purchased: " .. Item.Name)
    elseif Success == false then
        Notify(Msg or ("Could not buy " .. Item.Name))
    else
        Notify(Msg or ("Request sent: " .. Item.Name))
    end

    Button.Text = "Buy"
    BuyBusy = false
end

