local function SetAutoTime(Value)
    State.AutoTime = Value

    if Value then
        RunLoop("AutoTime", function(Active)
            if FindRemote("ClaimAllTimeRewards") then
                local Ok, Result = CallRemote("ClaimAllTimeRewards", 5)
                local Success = Describe(Result)

                if Ok and Success == true then
                    Notify("Time rewards claimed")
                end
            elseif FindRemote("ClaimTimeReward") then
                -- fallback: tenta coletar cada slot (marcos 5..60 min = 10 slots)
                for Slot = 1, 10 do
                    if not Active() then
                        break
                    end

                    CallRemote("ClaimTimeReward", 3, Slot)
                    task.wait(0.3)
                end
            end

            WaitActive(20, Active)
        end)
    end
end

