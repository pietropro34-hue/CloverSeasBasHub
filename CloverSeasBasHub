local function GetChar()
    return Player.Character
end

local function GetHum()
    local Char = GetChar()
    return Char and Char:FindFirstChildOfClass("Humanoid")
end

local function GetHRP()
    local Char = GetChar()
    return Char and Char:FindFirstChild("HumanoidRootPart")
end

-- Loop genérico que para sozinho quando o estado é desligado
local LoopIds = {}
local function RunLoop(Name, Body)
    LoopIds[Name] = (LoopIds[Name] or 0) + 1
    local Id = LoopIds[Name]

    local function Active()
        return State[Name] and LoopIds[Name] == Id
    end

    task.spawn(function()
        while Active() do
            local Ok = pcall(Body, Active)
            if not Ok then
                task.wait(1)
            end
        end
    end)
end

-- ===== HIGHLIGHT PLAYERS =====
local PlayerHL = {}
local PlayerHLConns = {}

local function GetModelOwner(Model)
    local Owner = Players:GetPlayerFromCharacter(Model)
    if Owner then
        return Owner
    end

    local Hum = Model:FindFirstChildOfClass("Humanoid")
    local HumName = Hum and Hum.DisplayName or ""
    local AttrId = Model:GetAttribute("UserId")

    for _, Plr in ipairs(Players:GetPlayers()) do
        if Model.Name == Plr.Name
            or Model.Name == Plr.DisplayName
            or (HumName ~= "" and (HumName == Plr.Name or HumName == Plr.DisplayName))
            or (AttrId ~= nil and AttrId == Plr.UserId) then
            return Plr
        end
    end

    return nil
end

local function TryHighlight(Model)
    if not State.PlayerHL then
        return
    end

    if not Model or not Model:IsA("Model") or PlayerHL[Model] then
        return
    end

    if not Model:FindFirstChildOfClass("Humanoid") then
        return
    end

    if Model == Player.Character then
        return
    end

    local Owner = GetModelOwner(Model)
    if not Owner or Owner == Player then
        return
    end

    local H = Instance.new("Highlight")
    H.Name = "BasHubPlayerHL"
    H.Adornee = Model
    H.FillColor = Color3.new(1, 1, 1)
    H.OutlineColor = Color3.new(1, 1, 1)
    H.FillTransparency = 0.5
    H.OutlineTransparency = 0
    H.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    H.Parent = Model

    PlayerHL[Model] = H

    H.Destroying:Connect(function()
        if PlayerHL[Model] == H then
            PlayerHL[Model] = nil
        end
    end)
end

local function RetryHighlight(Model)
    task.spawn(function()
        for _, Delay in ipairs({0, 0.3, 1.5, 4}) do
            if Delay > 0 then
                task.wait(Delay)
            end

            if not State.PlayerHL or not Model or not Model.Parent then
                return
            end

            if PlayerHL[Model] then
                return
            end

            TryHighlight(Model)
        end
    end)
end

local function WatchPlayer(Plr)
    if Plr == Player then
        return
    end

    if PlayerHLConns[Plr] then
        PlayerHLConns[Plr]:Disconnect()
    end

    PlayerHLConns[Plr] = Plr.CharacterAdded:Connect(RetryHighlight)

    if Plr.Character then
        RetryHighlight(Plr.Character)
    end
end

local function SetPlayerHL(Value)
    State.PlayerHL = Value

    for _, Conn in pairs(PlayerHLConns) do
        Conn:Disconnect()
    end
    table.clear(PlayerHLConns)

    for Model, H in pairs(PlayerHL) do
        H:Destroy()
        PlayerHL[Model] = nil
    end

    if not Value then
        return
    end

    task.spawn(function()
        for _, Object in ipairs(workspace:GetDescendants()) do
            if not State.PlayerHL then
                return
            end

            if Object:IsA("Humanoid") then
                RetryHighlight(Object.Parent)
            end
        end
    end)

    PlayerHLConns.Descendant = workspace.DescendantAdded:Connect(function(Object)
        if Object:IsA("Humanoid") then
            RetryHighlight(Object.Parent)
        end
    end)

    for _, Plr in ipairs(Players:GetPlayers()) do
        WatchPlayer(Plr)
    end

    PlayerHLConns.Added = Players.PlayerAdded:Connect(WatchPlayer)
    PlayerHLConns.Removed = Players.PlayerRemoving:Connect(function(Plr)
        if PlayerHLConns[Plr] then
            PlayerHLConns[Plr]:Disconnect()
            PlayerHLConns[Plr] = nil
        end
    end)

    RunLoop("PlayerHL", function()
        for Model, H in pairs(PlayerHL) do
            if H.Parent ~= Model then
                H:Destroy()
                PlayerHL[Model] = nil
            end
        end

        for _, Plr in ipairs(Players:GetPlayers()) do
            if Plr ~= Player and Plr.Character then
                TryHighlight(Plr.Character)
            end
        end

        task.wait(1)
    end)
end

-- ===== NOCLIP (também fica ligado enquanto qualquer farm estiver ativo) =====
local OriginalCollide = setmetatable({}, {__mode = "k"})

Track(RunService.Stepped:Connect(function()
    local Char = GetChar()
    if not Char then
        return
    end

    if State.Noclip or State.FarmLevel or State.MoneyFarm or Teleporting then
        for _, Part in ipairs(Char:GetDescendants()) do
            if Part:IsA("BasePart") and Part.CanCollide then
                OriginalCollide[Part] = true
                Part.CanCollide = false
            end
        end
    elseif next(OriginalCollide) ~= nil then
        for Part in pairs(OriginalCollide) do
            if Part.Parent then
                Part.CanCollide = true
            end
            OriginalCollide[Part] = nil
        end
    end
end))

-- ===== FLY =====
local FlyBV, FlyBG

local function StopFly()
    if FlyBV then
        FlyBV:Destroy()
        FlyBV = nil
    end

    if FlyBG then
        FlyBG:Destroy()
        FlyBG = nil
    end

    local Hum = GetHum()
    if Hum then
        Hum.PlatformStand = false
    end
end

local function SetFly(Value)
    State.Fly = Value
    if not Value then
        StopFly()
    end
end

Track(RunService.RenderStepped:Connect(function()
    if not State.Fly then
        return
    end

    local HRP, Hum = GetHRP(), GetHum()
    local Cam = workspace.CurrentCamera

    if not HRP or not Hum or not Cam then
        return
    end

    if not FlyBV or FlyBV.Parent ~= HRP then
        if FlyBV then FlyBV:Destroy() end
        FlyBV = Instance.new("BodyVelocity")
        FlyBV.MaxForce = Vector3.new(1e9, 1e9, 1e9)
        FlyBV.Velocity = Vector3.zero
        FlyBV.Parent = HRP
    end

    if not FlyBG or FlyBG.Parent ~= HRP then
        if FlyBG then FlyBG:Destroy() end
        FlyBG = Instance.new("BodyGyro")
        FlyBG.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
        FlyBG.P = 1e4
        FlyBG.D = 500
        FlyBG.Parent = HRP
    end

    Hum.PlatformStand = true

    local Look = Cam.CFrame.LookVector
    local Right = Cam.CFrame.RightVector
    local FlatLook = Vector3.new(Look.X, 0, Look.Z)
    local FlatRight = Vector3.new(Right.X, 0, Right.Z)

    if FlatLook.Magnitude > 0.01 then FlatLook = FlatLook.Unit end
    if FlatRight.Magnitude > 0.01 then FlatRight = FlatRight.Unit end

    local Move = Hum.MoveDirection
    local Forward = Move:Dot(FlatLook)
    local Side = Move:Dot(FlatRight)

    local Vertical = 0
    if UIS:IsKeyDown(Enum.KeyCode.Space) or Hum.Jump then
        Vertical += 1
    end
    if UIS:IsKeyDown(Enum.KeyCode.LeftControl) or UIS:IsKeyDown(Enum.KeyCode.Q) then
        Vertical -= 1
    end

    local Velocity = Look * Forward + Right * Side + Vector3.new(0, Vertical, 0)

    if Velocity.Magnitude > 1 then
        Velocity = Velocity.Unit
    end

    FlyBV.Velocity = Velocity * FLY_SPEED

    if FlatLook.Magnitude > 0.01 then
        FlyBG.CFrame = CFrame.new(Vector3.zero, FlatLook)
    end
end))

-- ===== SPEED / JUMP =====
local Applying = false
local HookedHum
local MoveConns = {}

local function ApplyMovement()
    if Applying then
        return
    end

    local Hum = GetHum()
    if not Hum then
        return
    end

    Applying = true

    pcall(function()
        if State.Speed and Hum.WalkSpeed ~= SpeedValue then
            Hum.WalkSpeed = SpeedValue
        end

        if State.Jump then
            if not Hum.UseJumpPower then
                Hum.UseJumpPower = true
            end

            if Hum.JumpPower ~= JumpValue then
                Hum.JumpPower = JumpValue
            end
        end
    end)

    Applying = false
end

local function HookHumanoid(Hum)
    for _, Conn in ipairs(MoveConns) do
        Conn:Disconnect()
    end
    table.clear(MoveConns)

    HookedHum = Hum

    for _, Prop in ipairs({"WalkSpeed", "JumpPower", "UseJumpPower"}) do
        table.insert(MoveConns, Hum:GetPropertyChangedSignal(Prop):Connect(ApplyMovement))
    end
end

local function EnsureHook()
    local Hum = GetHum()
    if Hum and Hum ~= HookedHum then
        HookHumanoid(Hum)
    end
end

Track(RunService.RenderStepped:Connect(function()
    EnsureHook()
    ApplyMovement()
end))

Track(RunService.Stepped:Connect(ApplyMovement))
Track(RunService.Heartbeat:Connect(function()
    EnsureHook()
    ApplyMovement()
end))

local function OnCharacter(Char)
    local Hum = Char:WaitForChild("Humanoid", 10)
    if Hum then
        HookHumanoid(Hum)
        ApplyMovement()
    end
end

if Player.Character then
    task.spawn(OnCharacter, Player.Character)
end

Track(Player.CharacterAdded:Connect(function(Char)
    task.spawn(OnCharacter, Char)
end))

local function SetSpeed(Value)
    State.Speed = Value
    EnsureHook()

    local Hum = GetHum()
    if not Hum then
        return
    end

    if Value then
        ApplyMovement()
    else
        Hum.WalkSpeed = DEFAULT_SPEED
    end
end

local function SetJump(Value)
    State.Jump = Value
    EnsureHook()

    local Hum = GetHum()
    if not Hum then
        return
    end

    if Value then
        ApplyMovement()
    else
        Hum.JumpPower = DEFAULT_JUMP
    end
end

-- ===== FUNÇÕES COMUNS DE FARM =====
local function GetPos(Object)
    if Object:IsA("Model") then
        return Object:GetPivot().Position
    end
    return Object.Position
end

local function TweenTo(Root, Position, Speed, Active)
    local Distance = (Root.Position - Position).Magnitude
    local Time = math.max(Distance / Speed, 0.05)

    local Tween = TweenService:Create(
        Root,
        TweenInfo.new(Time, Enum.EasingStyle.Linear),
        {CFrame = CFrame.new(Position)}
    )

    local Done = false
    Tween.Completed:Connect(function()
        Done = true
    end)

    Tween:Play()

    while not Done and Active() do
        Root.AssemblyLinearVelocity = Vector3.zero
        task.wait()
    end

    if not Done then
        Tween:Cancel()
    end

    Root.AssemblyLinearVelocity = Vector3.zero
end

-- Os dois farms mexem no personagem, então um desliga o outro
local SetFarmLevel, SetMoneyFarm

-- ===== FARM LEVEL =====
-- Fluxo: lê o level -> escolhe a maior quest liberada -> envia StartQuestEvent ->
-- equipa a Tool "Combat" -> tween até o NPC da quest -> fica atrás dele batendo (Tool:Activate).
-- O servidor valida tudo (level, tag "creator", nome do NPC).
local function GetLevel()
    if MANUAL_LEVEL then
        return MANUAL_LEVEL
    end

    local Main = Player:GetAttribute("PlayerLevel")
    if type(Main) == "number" then
        return Main
    end

    local Names = {"PlayerLevel", "Level", "Lvl", "Nivel", "Nível"}

    for _, Name in ipairs(Names) do
        local A = Player:GetAttribute(Name)
        if type(A) == "number" then
            return A
        end

        local Char = GetChar()
        local CA = Char and Char:GetAttribute(Name)
        if type(CA) == "number" then
            return CA
        end
    end

    for _, Object in ipairs(Player:GetDescendants()) do
        if (Object:IsA("IntValue") or Object:IsA("NumberValue"))
            and (Object.Name:lower() == "level" or Object.Name:lower() == "lvl") then
            return Object.Value
        end
    end

    return nil
end

local function FireQuest(Id)
    local Remote = ReplicatedStorage:FindFirstChild("StartQuestEvent")

    if Remote and Remote:IsA("RemoteEvent") then
        Remote:FireServer(Id)
    end
end

-- NPC vivo mais próximo com o nome exato da quest, dentro de Workspace.NPCS
local function FindNPC(NpcName, FromPosition)
    local Folder = workspace:FindFirstChild("NPCS")
    if not Folder then
        return nil, nil
    end

    local BestModel, BestRoot, BestDist

    for _, Object in ipairs(Folder:GetDescendants()) do
        if Object:IsA("Humanoid") and Object.Health > 0 then
            local Model = Object.Parent

            if Model and Model:IsA("Model") and Model.Name:lower() == NpcName then
                local Root = Model:FindFirstChild("HumanoidRootPart") or Model.PrimaryPart

                if Root then
                    local Dist = (Root.Position - FromPosition).Magnitude

                    if not BestDist or Dist < BestDist then
                        BestModel, BestRoot, BestDist = Model, Root, Dist
                    end
                end
            end
        end
    end

    return BestModel, BestRoot
end

local function EquipCombat()
    local Char, Hum = GetChar(), GetHum()
    if not Char or not Hum then
        return nil
    end

    local Tool = Char:FindFirstChild("Combat")
    if Tool and Tool:IsA("Tool") then
        return Tool
    end

    local Backpack = Player:FindFirstChildOfClass("Backpack")
    Tool = Backpack and Backpack:FindFirstChild("Combat")

    if Tool and Tool:IsA("Tool") then
        Hum:EquipTool(Tool)
        task.wait(0.15)
        return Tool
    end

    return nil
end

-- posição atrás do NPC, de frente pra ele
local function AttackCFrame(NpcRoot)
    local NpcPos = NpcRoot.Position
    local Behind = NpcPos - NpcRoot.CFrame.LookVector * ATTACK_DISTANCE
    Behind = Vector3.new(Behind.X, NpcPos.Y, Behind.Z)

    return CFrame.lookAt(Behind, Vector3.new(NpcPos.X, Behind.Y, NpcPos.Z))
end

local WarnedLevel = false

function SetFarmLevel(Value)
    State.FarmLevel = Value

    if not Value then
        SetStatus("-")
        return
    end

    if State.MoneyFarm then
        SetMoneyFarm(false)
        if ToggleButtons.MoneyFarm then
            ToggleButtons.MoneyFarm()
        end
    end

    RunLoop("FarmLevel", function(Active)
        local HRP, Hum = GetHRP(), GetHum()

        if not HRP or not Hum or Hum.Health <= 0 then
            SetStatus("aguardando respawn...")
            task.wait(1)
            return
        end

        local Level = GetLevel()

        if not Level and not WarnedLevel then
            WarnedLevel = true
            warn("[BasHub] Não consegui ler seu level. Usando level 1. Defina MANUAL_LEVEL no topo do script.")
        end

        local EffectiveLevel = Level or 1

        -- maior quest liberada que tenha NPC vivo no mapa
        local Quest, Target, TargetRoot

        for _, Q in ipairs(QUESTS) do
            if EffectiveLevel >= Q.Min then
                local Model, Root = FindNPC(Q.NPC, HRP.Position)

                if Model then
                    Quest, Target, TargetRoot = Q, Model, Root
                    break
                end
            end
        end

        if not Quest then
            SetStatus("Level " .. tostring(Level or "?") .. " | procurando NPCs...")
            task.wait(1)
            return
        end

        SetStatus("Level " .. tostring(Level or "?") .. " | Quest: " .. Quest.Id .. " | NPC: " .. Quest.NPC)

        FireQuest(Quest.Id)
        EquipCombat()

        -- vai até o NPC
        if (HRP.Position - TargetRoot.Position).Magnitude > 12 then
            TweenTo(HRP, AttackCFrame(TargetRoot).Position, FARM_TWEEN_SPEED, Active)
        end

        -- fica batendo até ele morrer (ou até reavaliar)
        local TargetHum = Target:FindFirstChildOfClass("Humanoid")
        local Start = os.clock()
        local LastQuest = os.clock()
        local LastAttack = 0

        while Active()
            and TargetHum
            and TargetHum.Health > 0
            and Target.Parent
            and TargetRoot.Parent
            and os.clock() - Start < FARM_REPICK do

            local Root, MyHum = GetHRP(), GetHum()
            if not Root or not MyHum or MyHum.Health <= 0 then
                break
            end

            Root.CFrame = AttackCFrame(TargetRoot)
            Root.AssemblyLinearVelocity = Vector3.zero

            local Now = os.clock()

            -- reenvia a quest (se já estiver ativa o servidor não reinicia; se concluiu, inicia de novo)
            if Now - LastQuest >= QUEST_REFIRE then
                LastQuest = Now
                FireQuest(Quest.Id)
            end

            if Now - LastAttack >= ATTACK_RATE then
                LastAttack = Now

                local Tool = GetChar() and GetChar():FindFirstChild("Combat")
                if not Tool then
                    Tool = EquipCombat()
                end

                if Tool and Tool.Parent == GetChar() then
                    pcall(function()
                        Tool:Activate()
                    end)
                end
            end

            RunService.Heartbeat:Wait()
        end

        task.wait(0.1)
    end)
end

-- ===== MONEY FARM (baús) =====
-- Workspace > Ilhas > Baus > (Ouro / Diamante) > Chest
-- A coleta é por toque (Touched) no servidor: o primeiro jogador que encostar leva o baú,
-- ele some pra todos e volta depois do cooldown (Ouro 120s / Diamante 360s).
local ChestFolders = {"Ouro", "Diamante"}

local function GetChests()
    local Result = {}
    local Ilhas = workspace:FindFirstChild("Ilhas")
    local Baus = Ilhas and Ilhas:FindFirstChild("Baus")

    if Baus then
        for _, FolderName in ipairs(ChestFolders) do
            local Folder = Baus:FindFirstChild(FolderName)

            if Folder then
                for _, Object in ipairs(Folder:GetChildren()) do
                    if Object.Name == "Chest" and (Object:IsA("Model") or Object:IsA("BasePart")) then
                        table.insert(Result, Object)
                    end
                end
            end
        end
    end

    return Result
end

-- Disponível = tem parte visível e que ainda aceita toque (em cooldown o baú fica invisível e sem toque)
local function IsAvailable(Chest)
    if not Chest:IsDescendantOf(workspace) then
        return false
    end

    if Chest:IsA("BasePart") then
        return Chest.Transparency < 0.99 and Chest.CanTouch
    end

    for _, Part in ipairs(Chest:GetDescendants()) do
        if Part:IsA("BasePart") and Part.Transparency < 0.99 and Part.CanTouch then
            return true
        end
    end

    return false
end

-- reforço local (o que vale mesmo é o contato físico no servidor)
local function TouchChest(Chest, Root)
    if not firetouchinterest then
        return
    end

    local function Touch(Part)
        pcall(function()
            firetouchinterest(Root, Part, 0)
            firetouchinterest(Root, Part, 1)
        end)
    end

    if Chest:IsA("BasePart") then
        Touch(Chest)
        return
    end

    for _, Part in ipairs(Chest:GetDescendants()) do
        if Part:IsA("BasePart") then
            Touch(Part)
        end
    end
end

local ChestSkip = setmetatable({}, {__mode = "k"})

function SetMoneyFarm(Value)
    State.MoneyFarm = Value
    table.clear(ChestSkip)

    if not Value then
        SetStatus("-")
        return
    end

    if State.FarmLevel then
        SetFarmLevel(false)
        if ToggleButtons.FarmLevel then
            ToggleButtons.FarmLevel()
        end
    end

    RunLoop("MoneyFarm", function(Active)
        local HRP, Hum = GetHRP(), GetHum()

        if not HRP or not Hum or Hum.Health <= 0 then
            SetStatus("aguardando respawn...")
            task.wait(1)
            return
        end

        -- sempre o baú disponível mais próximo da posição atual
        local Now = os.clock()
        local Best, BestDist

        for _, Chest in ipairs(GetChests()) do
            if (ChestSkip[Chest] or 0) < Now and IsAvailable(Chest) then
                local Dist = (GetPos(Chest) - HRP.Position).Magnitude

                if not BestDist or Dist < BestDist then
                    Best, BestDist = Chest, Dist
                end
            end
        end

        if not Best then
            SetStatus("todos os baús em cooldown (Ouro 120s / Diamante 360s)...")
            task.wait(1)
            return
        end

        SetStatus("indo para " .. Best.Parent.Name .. " (" .. math.floor(BestDist) .. " studs)")

        -- se a coleta falhar, só tenta esse baú de novo depois de 10s
        ChestSkip[Best] = Now + 10

        local function Alive()
            return Active() and IsAvailable(Best)
        end

        TweenTo(HRP, GetPos(Best), CHEST_TWEEN_SPEED, Alive)

        -- fica em cima do baú (subindo/descendo um pouco para gerar novos toques) até sumir
        local Start = os.clock()

        while Alive() and os.clock() - Start < CHEST_WAIT_TIME do
            local Root = GetHRP()
            if not Root then
                break
            end

            local Lift = (math.floor((os.clock() - Start) / 0.25) % 2) * 4

            Root.CFrame = CFrame.new(GetPos(Best) + Vector3.new(0, Lift, 0))
            Root.AssemblyLinearVelocity = Vector3.zero

            TouchChest(Best, Root)

            RunService.Heartbeat:Wait()
        end

        task.wait()
    end)
end

