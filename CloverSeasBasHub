    {Id = "midnight_soldier_boss", NPC = "midnight soldier", Min = 87},
    {Id = "possessed_farmer", NPC = "possessed farmer", Min = 52},
    {Id = "possessed_commoner", NPC = "possessed commoner", Min = 25},
