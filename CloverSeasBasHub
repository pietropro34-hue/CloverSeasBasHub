-- OPCIONAL: se você enviar a imagem para o Roblox, coloque o ID aqui (só números).
-- Deixando vazio, o script usa a logo embutida abaixo.
local LOGO_ASSET_ID = ""

local LOGO_BASE64 = [=[]=]

local B64_CHARS = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

local function DecodeBase64(Data)
    local Lookup = {}
    for Index = 1, #B64_CHARS do
        Lookup[B64_CHARS:byte(Index)] = Index - 1
    end

    local Clean = Data:gsub("[^%w%+/=]", "")
    local Pieces = {}

    for Index = 1, #Clean, 4 do
        local A = Lookup[Clean:byte(Index)]
        local B = Lookup[Clean:byte(Index + 1)]
        local Cc = Lookup[Clean:byte(Index + 2)]
        local D = Lookup[Clean:byte(Index + 3)]

        if A and B then
            local N = A * 262144 + B * 4096 + (Cc or 0) * 64 + (D or 0)
            local B1 = math.floor(N / 65536) % 256
            local B2 = math.floor(N / 256) % 256
            local B3 = N % 256

            if Cc and D then
                table.insert(Pieces, string.char(B1, B2, B3))
            elseif Cc then
                table.insert(Pieces, string.char(B1, B2))
            else
                table.insert(Pieces, string.char(B1))
            end
        end
    end

    return table.concat(Pieces)
end

local function LoadLogo()
    if LOGO_ASSET_ID ~= "" then
        return "rbxassetid://" .. LOGO_ASSET_ID
    end

    local GetAsset = getcustomasset or getsynasset

    if not (writefile and GetAsset) then
        return nil
    end

    local Ok, Result = pcall(function()
        local FileName = "BasHub_Logo.png"
        writefile(FileName, DecodeBase64(LOGO_BASE64))
        return GetAsset(FileName)
    end)

    if Ok and Result and Result ~= "" then
        return Result
    end

    return nil
end

